@echo off
setlocal DisableDelayedExpansion
set "NOTIZREGAL_PACKAGE_DIR=%~dp0"
echo Notizregal wird gestartet ...
powershell.exe -NoLogo -NoProfile -STA -ExecutionPolicy RemoteSigned -Command "$ErrorActionPreference='Stop'; try { $targetDir=Join-Path $env:LOCALAPPDATA 'Notizregal-App'; [void][IO.Directory]::CreateDirectory($targetDir); foreach ($name in @('Notizregal.ps1','TextTools.ps1','AudioTools.ps1','VersionTools.ps1','VersionUi.ps1','Stickerpalette.ps1')) { $source=Join-Path $env:NOTIZREGAL_PACKAGE_DIR $name; if (-not (Test-Path -LiteralPath $source -PathType Leaf)) { throw ('Datei fehlt: '+$name+'. Bitte das gesamte ZIP entpacken.') }; $local=Join-Path $targetDir $name; if (-not [string]::Equals([IO.Path]::GetFullPath($source),[IO.Path]::GetFullPath($local),[StringComparison]::OrdinalIgnoreCase)) { [IO.File]::Copy($source,$local,$true) }; Unblock-File -LiteralPath $local }; $sourceAssets=Join-Path $env:NOTIZREGAL_PACKAGE_DIR 'OpenMoji'; $destAssets=Join-Path $targetDir 'OpenMoji'; $sourceVersion=Join-Path $sourceAssets 'bundle.version'; $destVersion=Join-Path $destAssets 'bundle.version'; if (-not [IO.File]::Exists($sourceVersion)) { throw 'OpenMoji-Ordner fehlt. Bitte das gesamte ZIP entpacken.' }; $assetUpdate=(-not [IO.File]::Exists($destVersion)) -or ([IO.File]::ReadAllText($sourceVersion) -ne [IO.File]::ReadAllText($destVersion)); if ($assetUpdate -and -not [string]::Equals([IO.Path]::GetFullPath($sourceAssets),[IO.Path]::GetFullPath($destAssets),[StringComparison]::OrdinalIgnoreCase)) { Write-Host 'OpenMoji-Bilder werden einmalig lokal bereitgestellt ...'; [void][IO.Directory]::CreateDirectory($destAssets); foreach ($part in @('png','katalog.json','LICENSE-OpenMoji.txt','LICENSE-Unicode.txt','QUELLEN.txt')) { Copy-Item -LiteralPath (Join-Path $sourceAssets $part) -Destination $destAssets -Recurse -Force }; [IO.File]::Copy($sourceVersion,$destVersion,$true) }; $audioSource=Join-Path $env:NOTIZREGAL_PACKAGE_DIR 'AudioEngine'; $audioTarget=Join-Path $targetDir 'AudioEngine'; $audioSourceVersion=Join-Path $audioSource 'bundle.version'; $audioDestVersion=Join-Path $audioTarget 'bundle.version'; if (-not [IO.File]::Exists($audioSourceVersion)) { throw 'AudioEngine fehlt. Bitte das gesamte ZIP entpacken.' }; if ((-not [IO.File]::Exists($audioDestVersion)) -or ([IO.File]::ReadAllText($audioSourceVersion) -ne [IO.File]::ReadAllText($audioDestVersion))) { if (-not [string]::Equals([IO.Path]::GetFullPath($audioSource),[IO.Path]::GetFullPath($audioTarget),[StringComparison]::OrdinalIgnoreCase)) { Write-Host 'Offline-Spracherkennung wird einmalig bereitgestellt ...'; [void][IO.Directory]::CreateDirectory($audioTarget); foreach ($entry in (Get-ChildItem -LiteralPath $audioSource)) { if ($entry.Name -ne 'bundle.version') { Copy-Item -LiteralPath $entry.FullName -Destination $audioTarget -Recurse -Force } }; [IO.File]::Copy($audioSourceVersion,$audioDestVersion,$true) } }; $target=Join-Path $targetDir 'Notizregal.ps1'; & $target; if (-not $?) { exit 1 } } catch { $details=($_ | Format-List * -Force | Out-String); try { $logDir=Join-Path $env:LOCALAPPDATA 'Notizregal'; [void][IO.Directory]::CreateDirectory($logDir); $log=Join-Path $logDir 'startfehler.txt'; [IO.File]::WriteAllText($log,$details,[Text.UTF8Encoding]::new($true)); Write-Host ('Fehlerprotokoll: '+$log) } catch {}; Write-Host $details; exit 1 }"
if errorlevel 1 (
 echo.
 echo Notizregal konnte nicht gestartet werden. Die Fehlermeldung steht oben.
 echo Falls vorhanden: %%LOCALAPPDATA%%\Notizregal\startfehler.txt
 echo Bei einer zentralen Signaturpflicht ist eine Freigabe durch die IT erforderlich.
 pause
)
endlocal
